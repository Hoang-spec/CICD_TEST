BACKEND_IMAGE=123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/atelier-backend:release-001
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
CLIENT_ORIGIN=https://shop.example.com
# Percent-encode username/password URI characters. Keep sslmode=verify-full.
DATABASE_URL=postgres://atelier:REPLACE_ME@db.REPLACE_ME.ap-southeast-1.rds.amazonaws.com:5432/atelier?sslmode=verify-full
# Only needed when explicitly running the first-time seed:
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
